{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteAgent",
  "version": "0.1.0",
  "identifier": "dev.remoteagent.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteAgent",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/remoteagent-daemon"]
  }
}
